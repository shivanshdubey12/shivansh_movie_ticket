{
  "info": {
    "name": "IMovies API Collection",
    "description": "Comprehensive Postman Collection for IMovies Ticket Booking & Cinema Management Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"testuser@imovies.com\",\n  \"password\": \"password123\",\n  \"phone\": \"+91 98765 00000\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@imovies.com\",\n  \"password\": \"user123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@imovies.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get Current Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Movies",
      "item": [
        {
          "name": "Get All Movies (Filtered)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/movies?genre=Sci-Fi&status=now_showing"
          }
        },
        {
          "name": "Get Featured Spotlight Movies",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/movies/featured"
          }
        },
        {
          "name": "Get Single Movie by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/movies/:id"
          }
        }
      ]
    },
    {
      "name": "3. Theatres",
      "item": [
        {
          "name": "Get All Theatres",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/theatres?city=Mumbai"
          }
        },
        {
          "name": "Get All Unique Cities",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/theatres/cities"
          }
        }
      ]
    },
    {
      "name": "4. Shows & Seating",
      "item": [
        {
          "name": "Get Shows by Movie & Date",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/shows?movie=:movieId&date=2026-10-29"
          }
        },
        {
          "name": "Get Show Details with Seat Layout",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/shows/:showId"
          }
        }
      ]
    },
    {
      "name": "5. Bookings & Payments",
      "item": [
        {
          "name": "Create Booking (Reserve Seats)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"showId\": \"<SHOW_ID>\",\n  \"seatIds\": [\"<SEAT_ID_1>\", \"<SEAT_ID_2>\"],\n  \"paymentMethod\": \"Credit/Debit Card\",\n  \"paymentDetails\": {\n    \"cardNumber\": \"4242424242424242\",\n    \"cardHolder\": \"Alex Johnson\"\n  }\n}"
            },
            "url": "{{baseUrl}}/bookings"
          }
        },
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/bookings/my-bookings"
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/bookings/:bookingId/cancel"
          }
        }
      ]
    },
    {
      "name": "6. Admin Console",
      "item": [
        {
          "name": "Get Admin KPI Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/admin/stats"
          }
        },
        {
          "name": "Get All System Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/bookings"
          }
        }
      ]
    }
  ]
}

